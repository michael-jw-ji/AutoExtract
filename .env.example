# Copy to .env and fill in. NEVER commit .env.

# --- Inference: any OpenAI-compatible server. Defaults target local Ollama. ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama

# SMALL_MODEL serves extraction. LARGE_MODEL produces repairs, so make it the
# strongest model you can run. Use tags from `ollama list`.
SMALL_MODEL=qwen2.5:7b
LARGE_MODEL=qwen2.5:14b

# The HF model that LOCAL training fine-tunes (scripts/train_local.py). Not the
# same thing as SMALL_MODEL: Ollama serves models, it cannot train them.
TRAIN_BASE_MODEL=Qwen/Qwen3-4B

# --- Gate ---
# Candidate must beat incumbent field_f1 by at least this many percentage
# points, and must not regress valid_rate.
PROMOTION_MARGIN=2.0

# --- Training ---
# Fraction of the training set drawn from newly repaired failures.
REPAIR_FRACTION=0.7
# No single failure signature may exceed this share of the repair half.
MAX_CLUSTER_SHARE=0.25

# --- SEC EDGAR (scripts/fetch_form4.py) ---
# SEC requires a User-Agent that identifies you, e.g. "Your Name you@example.com".
# The fetcher refuses to run without it and sends nothing else.
SEC_USER_AGENT=
