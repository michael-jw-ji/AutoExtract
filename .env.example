# Copy to .env and fill in. NEVER commit .env.

# --- Required ---
BASETEN_API_KEY=

# --- Inference ---
BASETEN_BASE_URL=https://inference.baseten.co/v1

# Model IDs -- verified against a live key 2026-09-19 via scripts/check_models.py.
# SMALL_MODEL serves production traffic. LARGE_MODEL generates documents and
# produces repairs.
SMALL_MODEL=thinkingmachines/inkling-small
LARGE_MODEL=moonshotai/Kimi-K2.6

# The HF model that TRAINING fine-tunes. This is deliberately NOT SMALL_MODEL:
# Baseten Model APIs serve a fixed catalogue (no small open models on it),
# while Training Jobs fine-tune any HF model and deploy it separately.
TRAIN_BASE_MODEL=Qwen/Qwen3-4B

# --- Gate ---
# Candidate must beat incumbent field_f1 by at least this many percentage
# points, and must not regress valid_rate.
PROMOTION_MARGIN=2.0

# --- Training ---
# Fraction of the training set drawn from newly repaired failures.
REPAIR_FRACTION=0.7
# No single failure signature may exceed this share of the repair half.
MAX_CLUSTER_SHARE=0.25
