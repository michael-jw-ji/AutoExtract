# Copy to .env and fill in. NEVER commit .env.
# `make ci` needs none of this: it replays recorded answers.

# --- The served model: Qwen2.5-7B (+ LoRA) on Modal, see infra/modal_small.py ---
LLM_BASE_URL=https://<workspace>--insider-reading-small-serve.us-east.modal.run/v1
LLM_API_KEY=<the key in the Modal secret insider-reading-llm>
SMALL_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_CONCURRENCY=8

# --- The reference / judge model: Qwen2.5-32B on Modal, see infra/modal_llm.py ---
LARGE_LLM_BASE_URL=https://<workspace>--insider-reading-llm-serve.us-east.modal.run/v1
LARGE_LLM_API_KEY=<same key>
LARGE_MODEL=Qwen/Qwen2.5-32B-Instruct

# --- SEC EDGAR (scripts/fetch_form4.py, mcp_server.py with a URL) ---
# SEC requires a User-Agent that identifies you, e.g. "Your Name you@example.com".
SEC_USER_AGENT=
